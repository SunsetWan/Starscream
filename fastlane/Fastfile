default_platform(:ios)

require "json"

desc "Run tests"
lane :test do
  device = ENV["STARSCREAM_TEST_DEVICE"]
  if device.to_s.empty?
    simulator_json = sh("xcrun simctl list devices available -j", log: false)
    simulators = JSON.parse(simulator_json).fetch("devices").values.flatten
    device = simulators.find { |candidate| candidate.fetch("name").start_with?("iPhone") }&.fetch("name")
  end

  UI.user_error!("No available iPhone simulator was found") if device.to_s.empty?

  run_tests(
    project: "Starscream.xcodeproj",
    scheme: "Starscream",
    devices: [device],
    clean: true,
  )
end

platform :ios do
  desc "Deploy new version"
  lane :release do
    version = version_bump_podspec(path: "Starscream.podspec", version_number: ENV["TAG"])
    changelog = changelog_from_git_commits(merge_commit_filtering: "exclude_merges")

    github_release = set_github_release(
      repository_name: "daltoniam/starscream",
      api_token: ENV["GITHUB_TOKEN"],
      name: version,
      tag_name: version,
      description: changelog,
      commitish: "master"
    )
    pod_push(allow_warnings: false, verbose: true)
  end
end
